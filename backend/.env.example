# ==========================================
# Backend Environment Configuration
# ==========================================

# Security key - Use a strong unique secret in production
DJANGO_SECRET_KEY=django-insecure-dev-only-secret-key-change-in-prod-7_iduzv#=*i(0wh=(^=7y)xfwt9f0*sgtjvgruukr21^wilfql

# Debug mode: True for local development, False for production
DJANGO_DEBUG=True

# Comma-separated list of allowed hostnames
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],.railway.app,.up.railway.app

# Database Connection (Optional)
# If omitted or empty, defaults to local SQLite (db.sqlite3).
# On Railway, adding a PostgreSQL plugin automatically sets DATABASE_URL.
# Example: postgres://postgres:password@host:5432/railway
DATABASE_URL=

# CORS Allowed Origins (Comma-separated)
# For local development with React:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to True to allow all origins in development/testing
CORS_ALLOW_ALL_ORIGINS=True

# CSRF Trusted Origins (Comma-separated)
CSRF_TRUSTED_ORIGINS=https://*.railway.app,https://*.up.railway.app,http://localhost:3000,http://127.0.0.1:3000
