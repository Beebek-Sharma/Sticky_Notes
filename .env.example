# ========================================================
# Full-Stack Sticky Notes - Environment Variables Template
# ==========================================

# ------------------------------------------
# Django Backend Settings
# ------------------------------------------
DJANGO_SECRET_KEY=django-insecure-dev-only-secret-key-change-in-prod-7_iduzv#=*i(0wh=(^=7y)xfwt9f0*sgtjvgruukr21^wilfql
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],.railway.app,.up.railway.app

# Database (Optional - defaults to SQLite db.sqlite3)
# In Railway with PostgreSQL plugin, Railway automatically sets this
DATABASE_URL=

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=True
CSRF_TRUSTED_ORIGINS=https://*.railway.app,https://*.up.railway.app,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------
# React Frontend Settings
# ------------------------------------------
# In local dev: http://localhost:8000/api
# In production single-service on Railway: leave blank (defaults to /api)
# In production separate frontend on Railway: https://your-backend.up.railway.app/api
REACT_APP_API_BASE_URL=http://localhost:8000/api
PORT=8000
